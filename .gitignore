out
dist
# Compiled integration tests (tsc -p tsconfig.integration.json). Build output,
# so it must not dirty the tree between runs.
test-out
node_modules
.vscode-test/
*.vsix
# Runtime discovery file written by CliConnectorService on every activation.
# It contains a live IPC auth token; committing it leaks the credential and
# makes every checkout look permanently dirty.
.vscode/codelapse-connection.json
combine_*
combined_*
gg.py
.snapshots
scripts
.cursor
GEMINI.md
.kiro
.claude
# CLI black-box test sandbox: its own git repository and snapshot store.
cli-test-sandbox/

# Generated alert payloads, for every -State value: the script writes
# dependabot-fixed.json, code-scanning-auto_dismissed.csv and the like the same
# way, so match the whole directory rather than only the -open pair. Regenerate
# with:
#   pwsh -File security-reports/fetch-github-alerts.ps1 -State open
security-reports/*.json
security-reports/*.csv

# Local npm cache, used when the default cache directory is not writable. It
# sits in the repository root, so it is ignored here and in .vscodeignore both:
# git never reads .vscodeignore, and vsce never reads .gitignore, so a path
# hidden from only one of them still gets published.
.npm-cache/
# Internal agent and planning material. Hidden on this machine by
# .git/info/exclude and a nested .gitignore, neither of which is versioned, so
# a fresh clone would otherwise see the whole tree as untracked.
.superpowers/