{
  "$schema": "https://json-schema.org/draft-07/schema",
  "description": "CodeLapse configuration - shared between CLI and VS Code extension",
  "snapshotLocation": ".snapshots",
  "maxSnapshots": 50,
  "git": {
    "addCommitInfo": true
  },
  "semanticSearch": {
    "enabled": false,
    "provider": "gemini",
    "chunkSize": 200,
    "autoIndex": false
  }
}
