{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*"
  ],
  // Tests are excluded from the build output on purpose: they must not ship in
  // dist/. They are type-checked separately by tsconfig.test.json through the
  // `check-types:test` script, which CI runs. Excluding them here is exactly
  // what allowed four suites to fail to compile while `tsc --noEmit` still
  // exited 0, so do not "fix" this by deleting the exclude -- that would ship
  // test code and still not type-check it at build time.
  //
  // `src/**/__tests__/**` is load-bearing and was missing: `**/*.test.ts` alone
  // does not match the helpers in that directory, which do not end in
  // `.test.ts`. setup.ts and realFs.ts were therefore compiled into
  // dist/__tests__/ and shipped to npm by `files: ["dist/**/*"]`, where
  // setup.js calls jest.mock/beforeEach at module scope and throws a
  // ReferenceError when loaded. shared/tsconfig.json excludes both patterns;
  // this now matches it.
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "src/**/__tests__/**"
  ]
}