{
  "name": "codelapse-cli",
  "version": "2.0.0",
  "description": "Comprehensive command-line interface for CodeLapse VSCode extension with full feature parity",
  "main": "dist/cli.js",
  "bin": {
    "codelapse": "dist/cli.js",
    "cl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "check-types:test": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:ci": "jest --runInBand --forceExit --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublish": "npm run build"
  },
  "keywords": [
    "vscode",
    "snapshot",
    "cli",
    "terminal",
    "ai-tools",
    "version-control",
    "git",
    "github",
    "codelapse",
    "codelapse-cli",
    "code-analysis",
    "semantic-search",
    "diagnostics",
    "configuration",
    "automation",
    "developer-tools"
  ],
  "homepage": "https://github.com/YukioTheSage/code-snapshots",
  "bugs": {
    "url": "https://github.com/YukioTheSage/code-snapshots/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YukioTheSage/code-snapshots.git"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "author": "YukioTheSage",
  "license": "MIT",
  "dependencies": {
    "codelapse-core": "^0.9.5",
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.0",
    "ws": "^8.14.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "@types/inquirer": "^8.2.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "HELP.md"
  ]
}